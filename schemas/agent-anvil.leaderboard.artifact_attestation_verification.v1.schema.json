{
  "$id": "agent-anvil.leaderboard.artifact_attestation_verification.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent Anvil GitHub artifact attestation verification report schema.",
  "properties": {
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "benchmark_name": {
      "title": "Benchmark Name",
      "type": "string"
    },
    "bundle_path": {
      "default": "",
      "title": "Bundle Path",
      "type": "string"
    },
    "bundle_sha256": {
      "default": "",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "generated_by": {
      "title": "Generated By",
      "type": "string"
    },
    "github_repository": {
      "title": "Github Repository",
      "type": "string"
    },
    "github_run_url": {
      "title": "Github Run Url",
      "type": "string"
    },
    "github_sha": {
      "title": "Github Sha",
      "type": "string"
    },
    "predicate_type": {
      "title": "Predicate Type",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-anvil.leaderboard.artifact_attestation_verification.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "self_hosted_runners_denied": {
      "title": "Self Hosted Runners Denied",
      "type": "boolean"
    },
    "signer_workflow": {
      "default": "",
      "title": "Signer Workflow",
      "type": "string"
    },
    "source_digest": {
      "title": "Source Digest",
      "type": "string"
    },
    "source_ref": {
      "default": "",
      "title": "Source Ref",
      "type": "string"
    },
    "status": {
      "const": "verified",
      "title": "Status",
      "type": "string"
    },
    "subject_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Subject Sha256",
      "type": "string"
    },
    "submission_path": {
      "title": "Submission Path",
      "type": "string"
    },
    "trust_level": {
      "const": "github_actions",
      "title": "Trust Level",
      "type": "string"
    },
    "verification_output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verification Output Sha256",
      "type": "string"
    },
    "verified_attestations": {
      "minimum": 1,
      "title": "Verified Attestations",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "status",
    "submission_path",
    "agent_name",
    "benchmark_name",
    "trust_level",
    "github_repository",
    "github_sha",
    "github_run_url",
    "subject_sha256",
    "predicate_type",
    "source_digest",
    "self_hosted_runners_denied",
    "verified_attestations",
    "verification_output_sha256",
    "generated_at",
    "generated_by"
  ],
  "title": "LeaderboardArtifactAttestationVerification",
  "type": "object",
  "x-agent-anvil-schema-export-version": "anvil.schema.export.v1",
  "x-agent-anvil-schema-version": "agent-anvil.leaderboard.artifact_attestation_verification.v1"
}
