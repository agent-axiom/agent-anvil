{
  "$id": "agent-anvil.leaderboard.github_run_verification.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent Anvil GitHub Actions run verification report schema.",
  "properties": {
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "benchmark_name": {
      "title": "Benchmark Name",
      "type": "string"
    },
    "evidence_sha256": {
      "title": "Evidence Sha256",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "generated_by": {
      "title": "Generated By",
      "type": "string"
    },
    "github_repository": {
      "title": "Github Repository",
      "type": "string"
    },
    "github_run_url": {
      "title": "Github Run Url",
      "type": "string"
    },
    "github_sha": {
      "title": "Github Sha",
      "type": "string"
    },
    "schema_version": {
