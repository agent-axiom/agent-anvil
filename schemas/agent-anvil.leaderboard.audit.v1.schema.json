{
  "$defs": {
    "LeaderboardAuditRow": {
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "default": "",
          "title": "Agent Name",
          "type": "string"
        },
        "artifact_status": {
          "default": "not checked",
          "enum": [
            "verified",
            "not checked",
            "failed"
          ],
          "title": "Artifact Status",
          "type": "string"
        },
        "benchmark_name": {
          "default": "",
          "title": "Benchmark Name",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "review",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evidence_sha256": {
          "default": "",
          "title": "Evidence Sha256",
          "type": "string"
        },
        "github_run_status": {
          "default": "not checked",
          "enum": [
            "verified",
            "not checked",
            "failed"
          ],
          "title": "Github Run Status",
          "type": "string"
        },
        "maintainer_rerun_evidence_sha256": {
          "default": "",
          "title": "Maintainer Rerun Evidence Sha256",
          "type": "string"
        },
        "maintainer_rerun_path": {
          "default": "",
          "title": "Maintainer Rerun Path",
          "type": "string"
        },
        "maintainer_rerun_url": {
          "default": "",
          "title": "Maintainer Rerun Url",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "submission_path": {
          "title": "Submission Path",
          "type": "string"
        },
        "trace_aware_pass_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Aware Pass Rate"
        },
        "trust_level": {
          "default": "",
          "title": "Trust Level",
          "type": "string"
        }
      },
      "required": [
        "submission_path",
        "decision",
        "reason"
      ],
      "title": "LeaderboardAuditRow",
      "type": "object"
    },
    "LeaderboardAuditSummary": {
      "additionalProperties": false,
      "properties": {
        "accept": {
          "title": "Accept",
          "type": "integer"
        },
        "reject": {
          "title": "Reject",
          "type": "integer"
        },
        "review": {
          "title": "Review",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "accept",
        "review",
        "reject"
      ],
      "title": "LeaderboardAuditSummary",
      "type": "object"
    }
  },
  "$id": "agent-anvil.leaderboard.audit.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent Anvil public leaderboard maintainer audit report schema.",
  "properties": {
    "evidence_index_path": {
      "default": "",
      "title": "Evidence Index Path",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "generated_by": {
      "title": "Generated By",
      "type": "string"
    },
    "markdown": {
      "title": "Markdown",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/LeaderboardAuditRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "agent-anvil.leaderboard.audit.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "submissions_dir": {
      "title": "Submissions Dir",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/LeaderboardAuditSummary"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "generated_by",
    "submissions_dir",
    "summary",
    "rows",
    "markdown"
  ],
  "title": "LeaderboardAuditReport",
  "type": "object",
  "x-agent-anvil-schema-export-version": "anvil.schema.export.v1",
  "x-agent-anvil-schema-version": "agent-anvil.leaderboard.audit.v1"
}
