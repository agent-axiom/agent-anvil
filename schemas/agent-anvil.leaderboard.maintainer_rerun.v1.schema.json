{
  "$id": "agent-anvil.leaderboard.maintainer_rerun.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Agent Anvil public leaderboard maintainer rerun attestation schema.",
  "properties": {
    "agent_name": {
      "minLength": 1,
      "title": "Agent Name",
      "type": "string"
    },
    "benchmark_name": {
      "minLength": 1,
      "title": "Benchmark Name",
      "type": "string"
    },
    "final_answer_pass_rate": {
      "title": "Final Answer Pass Rate",
      "type": "number"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "generated_by": {
      "title": "Generated By",
      "type": "string"
    },
    "github_repository": {
      "default": "",
      "title": "Github Repository",
      "type": "string"
    },
    "github_run_url": {
      "minLength": 1,
      "title": "Github Run Url",
      "type": "string"
    },
    "github_sha": {
      "default": "",
      "title": "Github Sha",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "original_evidence_sha256": {
      "minLength": 1,
      "title": "Original Evidence Sha256",
      "type": "string"
    },
    "rerun_evidence_sha256": {
      "minLength": 1,
      "title": "Rerun Evidence Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-anvil.leaderboard.maintainer_rerun.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "const": "verified",
      "title": "Status",
      "type": "string"
    },
    "total_trials": {
      "title": "Total Trials",
      "type": "integer"
    },
    "trace_aware_pass_rate": {
      "title": "Trace Aware Pass Rate",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "status",
    "original_evidence_sha256",
    "rerun_evidence_sha256",
    "agent_name",
    "benchmark_name",
    "total_trials",
    "final_answer_pass_rate",
    "trace_aware_pass_rate",
    "github_run_url",
    "generated_at",
    "generated_by"
  ],
  "title": "LeaderboardMaintainerRerun",
  "type": "object",
  "x-agent-anvil-schema-export-version": "anvil.schema.export.v1",
  "x-agent-anvil-schema-version": "agent-anvil.leaderboard.maintainer_rerun.v1"
}
